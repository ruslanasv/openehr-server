              }
            ],
            "url": "{{base}}/rest/openehr/v1/query/aql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"q\": \"SELECT c/context/start_time/value AS ordered, m/activities[at0001]/description[at0002]/items[at0070]/value/value AS medication, m/activities[at0001]/description[at0002]/items[at0009]/value/value AS directions FROM EHR e CONTAINS COMPOSITION c CONTAINS INSTRUCTION m[openEHR-EHR-INSTRUCTION.medication_order.v3] WHERE e/ehr_status/subject/external_ref/id/value = $patient AND e/ehr_status/subject/external_ref/namespace = 'patients' ORDER BY c/context/start_time/value\",\n  \"query_parameters\": {\n    \"patient\": \"{{patient_id}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns rows\", () => pm.expect(pm.response.json().rows.length).to.be.at.least(2));"
                ]
              }
            }
          ]
        },
