        <term_definitions code="at0000"><items id="text">Problem/Diagnosis</items><items id="description">Details about a single identified health condition, injury, disability or any other issue which impacts on the physical, mental and/or social well-being of an individual.</items></term_definitions>
        <term_definitions code="at0001"><items id="text">structure</items><items id="description">@ internal @</items></term_definitions>
        <term_definitions code="at0002"><items id="text">Problem/Diagnosis name</items><items id="description">Identification of the problem or diagnosis, by name.</items></term_definitions>
        <term_definitions code="at0009"><items id="text">Clinical description</items><items id="description">Narrative description about the problem or diagnosis.</items></term_definitions>
        <term_definitions code="at0077"><items id="text">Date/time of onset</items><items id="description">Estimated or actual date/time that signs or symptoms of the problem/diagnosis were first observed.</items></term_definitions>
        <term_definitions code="at0005"><items id="text">Severity</items><items id="description">An assessment of the overall severity of the problem or diagnosis.</items></term_definitions>
        <term_definitions code="at0047"><items id="text">Mild</items><items id="description">The problem or diagnosis does not interfere with normal activity.</items></term_definitions>
        <term_definitions code="at0048"><items id="text">Moderate</items><items id="description">The problem or diagnosis causes some restriction of normal activity.</items></term_definitions>
        <term_definitions code="at0049"><items id="text">Severe</items><items id="description">The problem or diagnosis causes total restriction of normal activity.</items></term_definitions>
